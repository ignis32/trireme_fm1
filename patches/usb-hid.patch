+    RING_PUBLISH();
+    raw.out_full = 0;
+    fm1_usb_ep_send(FELUCCA_RAWHID_EP, rawtx, RAW_N);
+    sie_wr(S_TXCSR1, sie_rd(S_TXCSR1) | 0x01u);
+    raw.tx_pkts++;
