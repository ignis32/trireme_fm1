+    uint8_t rx_pend;             /* EP3 OUT packet seen, not yet taken (in[] was full) */
+    uint8_t e0_rx;               /* SET_REPORT to the raw interface: the report follows on EP0 */
+    uint32_t rx_pkts, tx_pkts, e0_sets;
