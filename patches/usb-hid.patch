+
+/* reports the ring can still take */
+static uint32_t hid_room(void)
+{
+    return HQ - (hq_w - hq_r);
+}
+
+/* main loop: queue one report (r[0] modifiers, r[1] 0, r[2..7] key codes); 0: the ring is full, try again */
+static int hid_push(const uint8_t r[8])
+{
+    uint32_t i;
+    if (hq_w - hq_r >= HQ)
+        return 0;
+    for (i = 0; i < 8u; i++) {
+        hid_q[hq_w % HQ][i] = r[i];
+        hid.cur[i] = r[i];
+    }
+    RING_PUBLISH();
+    hq_w++;
+    return 1;
+}
+#endif
