+    uint32_t i;
+    if (!raw.in_full)
+        return 0;
+    RING_PUBLISH();
+    for (i = 0; i < RAW_N; i++)
+        r[i] = raw.in[i];
+    RING_PUBLISH();
+    raw.in_full = 0;
+    return 1;
