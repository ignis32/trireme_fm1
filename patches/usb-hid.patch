+
+static void raw_tx(void)                                /* as ep3_tx */
+{
+    uint32_t csr, i;
+    if (!raw.out_full)
+        return;
+    sie_wr(S_INDEX, FELUCCA_RAWHID_EP);
+    csr = sie_rd(S_TXCSR1);
+    if (csr & 0x01u)
+        return;
+    if (csr & 0x80u)
+        sie_wr(S_TXCSR1, csr & ~0x80u);
+    RING_PUBLISH();
+    for (i = 0; i < RAW_N; i++)
